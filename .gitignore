# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo
.next/
out/

# Go indexer
indexer/pulsar.db
indexer/pulsar.db-shm
indexer/pulsar.db-wal
indexer/bin/
indexer/pulsar-indexer

# Environment and secrets: never committed, see .env.example for the shape
.env
.env.local
.env.*.local

# Test and coverage output
coverage/
*.out

# Maintainer-local planning material. These are working drafts shared across
# both Pulsar repos, not deliverables of this one. Only the README is tracked,
# and it explains what the directory holds. Same policy as pulsar-core.
docs/planning/*
!docs/planning/README.md

# Editor and OS noise
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Generated contract bindings, produced at test time by the ADR-016
# composition check. Keyed by contract ID, network, and SDK version.
tmp/
