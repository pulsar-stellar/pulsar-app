# Copy to .env.local and adjust. .env.local is gitignored and never committed.
# Every variable referenced anywhere in this repo appears here with a value that
# is safe to publish. Real secrets live in the Vercel and Render dashboards.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle. A secret
# must never carry that prefix.

# ---------- SDK / Web ----------
NEXT_PUBLIC_PULSAR_INDEXER_URL=http://localhost:8080
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# pulsar-core v0.1.0-contracts showcase contract, deployed to testnet
NEXT_PUBLIC_SHOWCASE_CONTRACT_ID=CDNWTVUDKCCGW7GOC6SBLUFXXUCD2YDHWRDUSXZ6CYBQKQWLCUYYWI5L

# ---------- Indexer ----------
PULSAR_INDEXER_LISTEN_ADDR=:8080
PULSAR_INDEXER_LOG_LEVEL=info
PULSAR_INDEXER_LOG_FORMAT=json
PULSAR_INDEXER_DB_DRIVER=sqlite
PULSAR_INDEXER_DB_URL=file:./pulsar.db
# For the postgres driver, set DB_DRIVER=postgres and use a connection string.
# sslmode must be require, verify-ca, or verify-full. Omitting it means
# sslmode=prefer, which silently falls back to an unencrypted connection
# carrying the password, and the indexer refuses to start on it. See ADR-031.
# PULSAR_INDEXER_DB_URL=postgres://user:pass@host:5432/pulsar?sslmode=require
#
# Connection pool bounds. Unset means the driver's own default: 10 and 2 for
# postgres, and exactly 1 for sqlite, which permits one writer at a time.
# PULSAR_INDEXER_DB_POOL_MAX=10
# PULSAR_INDEXER_DB_POOL_MIN=2
#
# Permits a postgres DSN that can fall back to plaintext. Local development
# against a Docker Postgres with no certificate, never a deployed instance.
PULSAR_INDEXER_DB_ALLOW_INSECURE_TLS=false
PULSAR_INDEXER_RPC_URL=https://soroban-testnet.stellar.org
PULSAR_INDEXER_NETWORK=testnet
PULSAR_INDEXER_POLL_INTERVAL_SEC=5
PULSAR_INDEXER_BATCH_SIZE=100
# Comma-separated contract IDs the indexer starts tracking on first run
PULSAR_INDEXER_BOOTSTRAP_CONTRACTS=CDNWTVUDKCCGW7GOC6SBLUFXXUCD2YDHWRDUSXZ6CYBQKQWLCUYYWI5L
