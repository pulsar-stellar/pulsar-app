{
  "name": "pulsar-app",
  "version": "0.0.0",
  "private": true,
  "description": "Application layer for Pulsar Stellar: TypeScript SDK, Go indexer, and Next.js explorer",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pulsar-stellar/pulsar-app.git"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "typescript-eslint": "8.67.0"
  }
}
