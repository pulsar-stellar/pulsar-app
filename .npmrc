# pnpm 11 ignores pnpm-specific keys in this file and reads them from
# pnpm-workspace.yaml instead. pnpm-workspace.yaml is authoritative; the keys
# below are kept only so pnpm 9 and 10 apply the same strictness. If you change
# one, change both. Rationale in ADR-001.

auto-install-peers=false
strict-peer-dependencies=true
engine-strict=true
shamefully-hoist=false

# Lockfile is authoritative; CI installs must never drift.
prefer-frozen-lockfile=true
