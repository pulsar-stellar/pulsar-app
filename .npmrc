# pnpm strictness settings for the whole workspace.
# Rationale for pnpm over npm/yarn workspaces is recorded in ADR-001.

# Fail rather than silently resolve a peer dependency we did not declare.
auto-install-peers=false
strict-peer-dependencies=true

# Refuse to install under a Node or pnpm version outside the engines range.
engine-strict=true

# Lockfile is authoritative; CI installs must never drift.
prefer-frozen-lockfile=true

# No implicit hoisting: a workspace may only import what it declares.
shamefully-hoist=false
